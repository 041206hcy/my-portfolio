{
  // Cloudflare Worker：静态资源（public/）+ 照片站的少量接口（src/index.js）
  // name 必须保持 myfirst，否则 Cloudflare 会当成一个新项目、线上地址会变
  "name": "myfirst",
  "compatibility_date": "2026-04-21",
  "main": "src/index.js",
  // 自定义域名：部署时 wrangler 会自动在 DNS 里建记录、签发证书，无需手工加 A 记录
  "routes": [
    { "pattern": "shackle0412.vip", "custom_domain": true },
    { "pattern": "www.shackle0412.vip", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // 让 Worker 先拿到请求：默认情况下静态资源由边缘直接返回、Worker 根本不会被调用，
    // 于是 src/index.js 里的 http→https 强制跳转对页面不生效（/api/* 仍会走 Worker）。
    "run_worker_first": true
  },
  // 结构化数据：旅程 / 照片 / 票据 / 轨迹段
  // database_id 先放占位 UUID（本地开发用不到真实 id）；等你在 Cloudflare 建好 D1 后换成真实值
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "photosite",
      "database_id": "0540344a-dddc-4190-9547-2fe085ab75fc"
    }
  ],
  // 照片文件：两档网页尺寸（缩略图 + 1600px）直接存在 D1 的 blobs 表里，不需要 R2 绑定。
  // 想改用 R2：把 r2_buckets 加回来（binding 用 BUCKET），再把 src/index.js 里的 blobPut/blobGet/blobDelete 换回 env.BUCKET。
  // 本地开发时管理接口不设防；线上部署前置 Cloudflare Access 后再改成 "1"
  "vars": {
    // 管理接口的锁：口令的 SHA-256。明文口令只在你浏览器里，仓库里放哈希是安全的。
    "REQUIRE_ACCESS": "0",
    "ADMIN_TOKEN_SHA256": "d4d3286f9c6b13ae255c49bc7117c3ea14fde7dbcc4f057904adb7e47c8ce277"
  }
}