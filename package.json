{
  "name": "shackle0412-site",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --no-warnings tools/dev-harness.mjs --port 8787",
    "dev:wrangler": "wrangler dev --port 8787",
    "smoke": "node --no-warnings tools/smoke.mjs",
    "check": "node tools/dom-check.mjs && node --no-warnings tools/pages-check.mjs",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 execute photosite --local --file=./schema.sql",
    "db:remote": "wrangler d1 execute photosite --remote --file=./schema.sql"
  },
  "devDependencies": {
    "exifr": "7.1.3",
    "leaflet": "1.9.4",
    "leaflet.markercluster": "1.5.3",
    "wrangler": "4.151.3"
  }
}